---
interface Props {
  heading?: string;
  body?: string;
  formId?: string;
  compact?: boolean;
  /** Use 'h2' when this band is the primary heading on its page (e.g. a standalone newsletter page). */
  headingLevel?: 'h2' | 'h3';
}

const {
  heading = 'Get the free Retreat Vetting Checklist',
  body = 'Join the newsletter for vetted retreat updates, legal-status changes, and our 12-point checklist before you book anything.',
  // MailerLite → Forms → "Website newsletter" (adds to the "Newsletter" group). Both IDs are public.
  formId = import.meta.env.PUBLIC_MAILERLITE_FORM_ID || '202276800073566058',
  compact = false,
  headingLevel = 'h3',
} = Astro.props;
const accountId = import.meta.env.PUBLIC_MAILERLITE_ACCOUNT_ID || '2740054';
const Heading = headingLevel;
---

<div class:list={['rounded-xl border border-line bg-forest-900 text-cream', compact ? 'p-6' : 'p-8 sm:p-10']}>
  <div class:list={['mx-auto flex flex-col gap-4', !compact && 'max-w-2xl items-center text-center']}>
    <Heading class:list={['font-serif font-medium text-cream', compact ? 'text-xl' : 'text-2xl sm:text-3xl']}>{heading}</Heading>
    <p class="text-sm text-forest-100/90">{body}</p>

    <!-- Posts to MailerLite's form endpoint; the script below submits it in-page (CORS is open) and falls back to a normal POST without JS. -->
    <form
      class="mt-2 flex w-full max-w-md flex-col gap-2 sm:flex-row"
      action={`https://assets.mailerlite.com/jsonp/${accountId}/forms/${formId}/subscribe`}
      method="post"
      data-newsletter-form
    >
      <input type="hidden" name="ml-submit" value="1" />
      <input type="hidden" name="anticsrf" value="true" />
      <label for="newsletter-email" class="sr-only">Email address</label>
      <input
        id="newsletter-email"
        type="email"
        name="fields[email]"
        required
        placeholder="you@example.com"
        class="w-full flex-1 rounded-lg border-0 bg-white px-4 py-2.5 text-sm text-charcoal placeholder:text-charcoal-soft focus:outline-none focus:ring-2 focus:ring-terracotta-500"
      />
      <button
        type="submit"
        class="rounded-lg bg-terracotta-600 px-5 py-2.5 text-sm font-semibold text-cream transition hover:bg-terracotta-700"
      >
        Send it to me
      </button>
    </form>
    <p class="hidden text-sm text-cream" role="status" aria-live="polite" data-newsletter-status></p>
    <p class="text-xs text-forest-100/90">No spam. Unsubscribe anytime. See our <a href="/privacy/" class="text-cream underline">privacy policy</a>.</p>
  </div>
</div>

<script>
  const CHECKLIST_URL = '/guides/retreat-vetting-checklist-12-questions/';

  document.querySelectorAll<HTMLFormElement>('form[data-newsletter-form]').forEach((form) => {
    const status = form.parentElement?.querySelector<HTMLElement>('[data-newsletter-status]');
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');

    const show = (html: string) => {
      if (!status) return;
      status.innerHTML = html;
      status.classList.remove('hidden');
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (button) button.disabled = true;
      const data = new FormData(form);
      data.set('ajax', '1');
      try {
        const res = await fetch(form.action, { method: 'POST', body: data });
        const json = await res.json();
        if (!json.success) throw new Error(JSON.stringify(json.errors ?? json));
        form.classList.add('hidden');
        show(
          `You're subscribed — thank you. Here's the checklist: <a class="underline" href="${CHECKLIST_URL}">12 questions to ask before booking any retreat</a>.`,
        );
        (window as any).gtag?.('event', 'sign_up', { method: 'newsletter', page_path: location.pathname });
      } catch (err) {
        console.error('Newsletter signup failed', err);
        show('Sorry, that didn\'t go through. Check the email address and try again.');
        if (button) button.disabled = false;
      }
    });
  });
</script>
