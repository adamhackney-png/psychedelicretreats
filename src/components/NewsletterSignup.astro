---
import Pattern from './Pattern.astro';

interface Props {
  heading?: string;
  body?: string;
  formId?: string;
  compact?: boolean;
  /** Use 'h2' when this band is the primary heading on its page (e.g. a standalone newsletter page). */
  headingLevel?: 'h2' | 'h3';
  /** Placement label recorded with each join (e.g. 'home', 'guide', 'newsletter-page', 'retreat-match'). */
  source?: string;
}

const {
  heading = 'Get the free Retreat Vetting Checklist',
  body = 'Join the newsletter for vetted retreat updates, legal-status changes, and our 12-point checklist before you book anything.',
  // MailerLite → Forms → "Website newsletter" (adds to the "Newsletter" group). Both IDs are public.
  formId = import.meta.env.PUBLIC_MAILERLITE_FORM_ID || '202276800073566058',
  compact = false,
  headingLevel = 'h3',
  source = 'other',
} = Astro.props;
const accountId = import.meta.env.PUBLIC_MAILERLITE_ACCOUNT_ID || '2740054';
const Heading = headingLevel;
const inputId = `newsletter-email-${source}`;
---

<div class:list={['newsletter-band relative overflow-hidden bg-tomato text-white', compact ? 'p-6' : 'px-6 py-12 sm:px-12 sm:py-16']}>
  {!compact && <Pattern seed={`newsletter-${source}`} ink="w" anchor={[1, 0.5]} reach={1.4} cols={22} rows={18} class="newsletter-pattern" />}
  <div class:list={['relative z-10 flex flex-col gap-4', !compact && 'max-w-[640px]']}>
    <Heading class:list={['font-serif text-white', compact ? 'text-[1.625rem] leading-tight' : 'text-[2.25rem] leading-none sm:text-[3.5rem]']}>{heading}</Heading>
    <p class:list={['text-white', compact ? 'text-[0.95rem]' : 'text-[1.1rem]']}>{body}</p>

    <!-- Posts to MailerLite's form endpoint; the script below submits it in-page (CORS is open) and falls back to a normal POST without JS. -->
    <form
      class="mt-2 flex w-full max-w-[540px] flex-wrap bg-white"
      action={`https://assets.mailerlite.com/jsonp/${accountId}/forms/${formId}/subscribe`}
      method="post"
      data-newsletter-form
      data-source={source}
    >
      <!-- The script adds fields[signup_source] ("<placement>:<page path>") on submit. It needs a text field with key "signup_source" in MailerLite; if missing, the script retries without it so joins never fail. -->
      <input type="hidden" name="ml-submit" value="1" />
      <input type="hidden" name="anticsrf" value="true" />
      <label for={inputId} class="sr-only">Email address</label>
      <input
        id={inputId}
        type="email"
        name="fields[email]"
        required
        placeholder="you@example.com"
        class="min-h-[3.25rem] min-w-0 flex-[1_1_13rem] border-0 bg-transparent px-4 text-base text-charcoal placeholder:text-charcoal-soft focus:outline-none focus-visible:outline-3 focus-visible:outline-offset-0 focus-visible:outline-charcoal"
      />
      <button
        type="submit"
        class="min-h-[3.25rem] flex-[1_0_auto] bg-charcoal px-6 text-[0.95rem] font-bold text-white transition hover:bg-cobalt disabled:opacity-60"
      >
        Send it to me
      </button>
    </form>
    <p class="hidden text-base text-white [&_a]:text-white" role="status" aria-live="polite" data-newsletter-status></p>
    <p class="text-sm text-white">No spam. Unsubscribe anytime. See our <a href="/privacy/" class="text-white underline">privacy policy</a>.</p>
  </div>
</div>

<style>
  .newsletter-band :global(.newsletter-pattern) {
    right: 0;
    top: 0;
    height: 100%;
    width: 52%;
  }
  @media (max-width: 760px) {
    .newsletter-band :global(.newsletter-pattern) {
      width: 100%;
      opacity: 0.35;
    }
  }
</style>

<script>
  const CHECKLIST_URL = '/guides/retreat-vetting-checklist-12-questions/';

  document.querySelectorAll<HTMLFormElement>('form[data-newsletter-form]').forEach((form) => {
    const status = form.parentElement?.querySelector<HTMLElement>('[data-newsletter-status]');
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');

    const show = (html: string) => {
      if (!status) return;
      status.innerHTML = html;
      status.classList.remove('hidden');
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (button) button.disabled = true;
      const placement = form.dataset.source || 'other';
      const sourceValue = `${placement}:${location.pathname}`.slice(0, 120);
      const data = new FormData(form);
      data.set('ajax', '1');
      data.set('fields[signup_source]', sourceValue);
      try {
        const send = async (body: FormData) => {
          const res = await fetch(form.action, { method: 'POST', body });
          return res.json();
        };
        let json = await send(data);
        // If MailerLite rejects only because the source field isn't set up, retry without it.
        const fieldErrors = JSON.stringify(json.errors ?? {});
        if (!json.success && /signup_source/i.test(fieldErrors)) {
          data.delete('fields[signup_source]');
          json = await send(data);
        }
        if (!json.success) throw new Error(JSON.stringify(json.errors ?? json));
        form.classList.add('hidden');
        show(
          `You're subscribed — thank you. Here's the checklist: <a class="underline" href="${CHECKLIST_URL}">12 questions to ask before booking any retreat</a>.`,
        );
        (window as any).gtag?.('event', 'sign_up', { method: 'newsletter', page_path: location.pathname, signup_source: placement });
      } catch (err) {
        console.error('Newsletter signup failed', err);
        show('Sorry, that didn\'t go through. Check the email address and try again.');
        if (button) button.disabled = false;
      }
    });
  });
</script>
