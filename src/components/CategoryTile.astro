---
/** A colour-field category link with a pattern cluster in the top-right corner. */
import Pattern from './Pattern.astro';
import { FIELDS, CATEGORY_FIELD, fieldFor } from '../lib/pattern';

interface Props {
  slug: string;
  href: string;
  label: string;
  description: string;
  headingLevel?: 'h2' | 'h3';
}

const { slug, href, label, description, headingLevel = 'h3' } = Astro.props;
const color = CATEGORY_FIELD[slug] ?? fieldFor(slug);
const field = FIELDS[color];
const Heading = headingLevel;
---

<a href={href} class:list={['category-tile group', field.ink === 'w' ? 'text-white' : 'text-charcoal']} style={`background:${field.bg}`}>
  <Pattern seed={`category-${slug}`} ink={field.ink} anchor={[1, 0]} class="category-tile-pattern" />
  <Heading class:list={['relative z-10 font-serif text-[2.25rem] leading-[1.04] group-hover:underline group-hover:decoration-2 group-hover:underline-offset-[5px]', field.ink === 'w' ? 'text-white' : 'text-charcoal']}>{label}</Heading>
  <span class="relative z-10 mt-2.5 block max-w-[22em] text-[1.03rem] font-medium">{description}</span>
</a>

<style>
  .category-tile {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 21rem;
    padding: 1.75rem;
    overflow: hidden;
    text-decoration: none;
  }
  .category-tile :global(.category-tile-pattern) {
    right: 0;
    top: 0;
    width: 72%;
    height: 72%;
  }
  @media (max-width: 900px) {
    .category-tile {
      min-height: 18rem;
    }
  }
</style>
