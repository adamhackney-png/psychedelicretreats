---
import { PRICE_BANDS } from '../lib/site';
import FieldArt from './FieldArt.astro';
import { FIELD_ORDER } from '../lib/pattern';

interface Props {
  slug: string;
  name: string;
  mode: 'standard' | 'neutral';
  categoryLabel: string;
  country: string;
  destinationSlug: string;
  region?: string;
  priceBandAUD?: string;
  durationDays?: number;
  featuredTier?: 'featured' | 'premium';
  claimed: boolean;
  image?: string;
  /** Position in its grid; spreads field colours so neighbours differ. */
  index?: number;
}

const {
  slug,
  name,
  mode,
  categoryLabel,
  country,
  destinationSlug,
  region,
  priceBandAUD,
  durationDays,
  featuredTier,
  claimed,
  image,
  index,
} = Astro.props;
const color = index === undefined ? undefined : FIELD_ORDER[index % FIELD_ORDER.length];

const location = region ? `${region}, ${country}` : country;
const href = `/listing/${slug}/`;
---

{/* Outer element carries no display utility so FilterBar's `hidden` toggle always wins. */}
{mode === 'neutral' ? (
  <article
    class="listing-card border-2 border-charcoal bg-white p-5"
    data-destination={destinationSlug}
    data-price-band={priceBandAUD ?? ''}
    data-duration-days={durationDays ?? ''}
  >
    <p class="caps text-terracotta-600">{categoryLabel}</p>
    <h3 class="mt-2 font-serif text-[1.625rem] leading-tight text-charcoal">
      <a href={href} class="text-charcoal no-underline hover:underline">{name}</a>
    </h3>
    <p class="mt-1 text-[0.9375rem] text-charcoal-soft">{location}</p>
    <p class="mt-3 text-sm text-charcoal-soft">
      Australian clinical service — factual listing only, not affiliated, no CTA. See listing for a contact link.
    </p>
  </article>
) : (
  <a
    href={href}
    class="listing-card group text-charcoal no-underline"
    data-destination={destinationSlug}
    data-price-band={priceBandAUD ?? ''}
    data-duration-days={durationDays ?? ''}
  >
    <div class="relative">
      {image ? (
        <div class="aspect-[4/3] w-full bg-cover bg-center" style={`background-image:url(${image})`}></div>
      ) : (
        <FieldArt seed={slug} color={color} corner="br" class="aspect-[4/3] w-full" />
      )}
      <span class="caps absolute left-0 top-0 z-10 bg-charcoal px-3 py-2 text-[0.75rem] text-white">{categoryLabel}</span>
      {featuredTier && (
        <span class="caps absolute right-0 top-0 z-10 bg-white px-3 py-2 text-[0.75rem] text-charcoal">
          {featuredTier === 'premium' ? 'Premium Partner' : 'Featured'}
        </span>
      )}
    </div>
    <h3 class="mt-4 font-serif text-[1.75rem] leading-[1.08] text-charcoal group-hover:underline group-hover:decoration-2 group-hover:underline-offset-4">{name}</h3>
    <p class="mt-1.5 text-[0.9375rem] text-charcoal-soft">{location}</p>
    {(priceBandAUD || durationDays) && (
      <ul class="mt-3 flex flex-wrap gap-2 text-sm font-bold">
        {priceBandAUD && <li class="border-2 border-charcoal px-2.5 py-0.5">{PRICE_BANDS[priceBandAUD] ?? priceBandAUD}</li>}
        {durationDays && <li class="border-2 border-charcoal px-2.5 py-0.5">{durationDays} days</li>}
      </ul>
    )}
  </a>
)}
