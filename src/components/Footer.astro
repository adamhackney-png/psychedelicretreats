---
import { SITE } from '../lib/site';

const columns = [
  {
    heading: 'Explore',
    links: [
      { label: 'Retreats', href: '/retreats/' },
      { label: 'Clinics', href: '/clinics/ketamine/' },
      { label: 'Integration', href: '/integration/' },
      { label: 'Destinations', href: '/destinations/' },
      { label: 'Guides', href: '/guides/' },
      { label: 'News', href: '/news/' },
    ],
  },
  {
    heading: 'Tools',
    links: [
      { label: 'Retreat Match Quiz', href: '/tools/retreat-match/' },
      { label: 'Cost Calculator', href: '/tools/cost-calculator/' },
      { label: 'Legality Map', href: '/tools/legality-map/' },
      { label: 'For Operators', href: '/for-operators/' },
    ],
  },
  {
    heading: 'About',
    links: [
      { label: 'About Us', href: '/about/' },
      { label: 'Editorial Policy', href: '/editorial-policy/' },
      { label: 'Medical Disclaimer', href: '/medical-disclaimer/' },
      { label: 'Contact', href: '/contact/' },
    ],
  },
  {
    heading: 'Legal',
    links: [
      { label: 'Terms of Use', href: '/terms/' },
      { label: 'Privacy Policy', href: '/privacy/' },
      { label: 'Newsletter', href: '/newsletter/' },
    ],
  },
];
---

<footer class="mt-24 bg-cream">
  <div class="mx-auto max-w-[1360px] px-4 pb-11 pt-16 sm:px-6 lg:px-10">
    <p class="footer-word font-serif text-charcoal" aria-hidden="true">Psychedelic Retreats Australia</p>
    <div class="grid grid-cols-2 gap-8 md:grid-cols-4">
      {columns.map((col) => (
        <div>
          <p class="caps text-charcoal">{col.heading}</p>
          <ul class="mt-3 space-y-1">
            {col.links.map((link) => (
              <li>
                <a href={link.href} class="inline-block py-1 text-[1rem] text-charcoal no-underline hover:underline">{link.label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="mt-10 max-w-[78em] space-y-3 border-t-2 border-charcoal pt-6 text-sm leading-relaxed text-charcoal-soft">
      <p>
        <strong class="font-semibold text-charcoal">{SITE.name}</strong> is an independent publisher and directory.
        We are not a medical provider, retreat operator, booking agent, or referrer, and we do not receive
        prescriber referrals. Nothing on this site is medical advice — see our{' '}
        <a href="/medical-disclaimer/" class="text-charcoal underline">medical disclaimer</a>. Some listings include affiliate
        links, marked accordingly — see our <a href="/editorial-policy/" class="text-charcoal underline">editorial policy</a>.
      </p>
      <p>ABN: [ABN PLACEHOLDER] · Contact: <a href={`mailto:${SITE.contactEmail}`} class="text-charcoal underline">{SITE.contactEmail}</a></p>
      <p>&copy; {new Date().getFullYear()} {SITE.name}. All rights reserved.</p>
    </div>
  </div>
</footer>

<style>
  footer {
    border-top: 3px solid var(--color-ink);
  }
  .footer-word {
    font-size: clamp(2.5rem, 9.3vw, 8.75rem);
    line-height: 0.92;
    margin: 0 0 2.75rem;
    padding-bottom: 1.75rem;
    border-bottom: 3px solid var(--color-ink);
  }
</style>
