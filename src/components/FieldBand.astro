---
/** Page-intro band: a flat colour field with the page's pattern cluster on the right. */
import Pattern from './Pattern.astro';
import { FIELDS, fieldFor, type FieldColor } from '../lib/pattern';

interface Props {
  seed: string;
  color?: FieldColor;
}

const { seed, color = fieldFor(seed) } = Astro.props;
const field = FIELDS[color];
---

<section class="mx-auto max-w-[1360px] px-4 pb-10 sm:px-6 lg:px-10">
  <div class:list={['field-band', field.ink === 'w' ? 'is-dark' : 'is-light']} style={`background:${field.bg}`}>
    <Pattern seed={seed} ink={field.ink} anchor={[1, 0]} cols={22} rows={14} class="field-band-pattern" />
    <div class="field-band-body">
      <slot />
    </div>
  </div>
</section>

<style>
  .field-band {
    position: relative;
    overflow: hidden;
    padding: 3.5rem 2rem 2.5rem;
  }
  .field-band :global(.field-band-pattern) {
    right: 0;
    top: 0;
    width: 50%;
    height: 100%;
  }
  .field-band-body {
    position: relative;
    z-index: 1;
    max-width: 46rem;
  }
  .is-dark,
  .is-dark :global(h1),
  .is-dark :global(p),
  .is-dark :global(a) {
    color: #fff;
  }
  .is-light,
  .is-light :global(h1),
  .is-light :global(p) {
    color: var(--color-ink);
  }
  @media (max-width: 760px) {
    .field-band {
      padding: 2.5rem 1.25rem 2rem;
    }
    .field-band :global(.field-band-pattern) {
      width: 100%;
      height: 70%;
      opacity: 0.35;
    }
  }
</style>
