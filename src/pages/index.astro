---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import ListingCard from '../components/ListingCard.astro';
import CategoryTile from '../components/CategoryTile.astro';
import Pattern from '../components/Pattern.astro';
import { RETREAT_CATEGORIES, CATEGORY_META, isRetreatCategory } from '../lib/site';

const featuredRetreats = (
  await getCollection('listings', (entry) => entry.data.mode === 'standard' && entry.data.categories.some(isRetreatCategory))
)
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0, 6);

// Draft items are included (same as /news/) since nothing is hidden from the site,
// just marked and noindexed until reviewed — see each item's draft banner.
const latestNews = (await getCollection('news'))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0, 4);
---

<BaseLayout
  title="Psychedelic Retreats Australia — Independent Directory & Guides"
  description="An independent Australian directory and information hub for legal psychedelic retreats abroad, Australian clinical services, breathwork retreats, and integration support."
>
  <!-- Hero -->
  <section class="hero relative overflow-hidden bg-cobalt text-white">
    <Pattern seed="home-hero" ink="w" cols={26} rows={36} anchor={[1, 0.35]} reach={1.35} class="hero-pattern" />
    <div class="relative mx-auto max-w-[1360px] px-4 pb-16 pt-14 sm:px-6 md:pb-24 md:pt-20 lg:px-10">
      <div class="relative z-10 max-w-[740px]">
        <p class="caps text-marigold">Independent · Australian · Evidence-aware</p>
        <h1 class="mt-5 font-serif text-[2.875rem] leading-[0.98] text-white sm:text-[4.5rem] lg:text-[6rem]">
          Find a legal psychedelic retreat, informed by <span class="text-marigold">facts, not hype.</span>
        </h1>
        <p class="mt-7 max-w-[30em] text-[1.2rem] leading-relaxed text-white sm:text-[1.3rem]">
          We vet and catalogue legal psychedelic retreats abroad, Australian clinical pathways, and breathwork
          and integration support — with sourced facts, not promotional claims.
        </p>

        <form action="/search/" method="get" class="mt-9 flex max-w-[600px] flex-wrap bg-white">
          <label for="hero-search" class="sr-only">Search retreats</label>
          <input
            id="hero-search"
            type="text"
            name="q"
            placeholder="Search destinations, modalities, or retreat names…"
            class="min-h-[3.5rem] min-w-0 flex-[1_1_15rem] border-0 bg-transparent px-4 text-base text-charcoal placeholder:text-charcoal-soft focus:outline-none focus-visible:outline-3 focus-visible:outline-offset-0 focus-visible:outline-marigold"
          />
          <button type="submit" class="min-h-[3.5rem] bg-charcoal px-7 text-base font-bold text-white transition hover:bg-tomato">
            Search
          </button>
        </form>

        <ul class="mt-7 flex flex-wrap gap-x-6 gap-y-2 text-base font-semibold">
          <li class="marks">Independent</li>
          <li class="marks">No underground listings</li>
          <li class="marks">Evidence-aware</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Featured retreats -->
  <section class="mx-auto max-w-[1360px] px-4 py-16 sm:px-6 md:py-20 lg:px-10">
    <div class="flex flex-wrap items-baseline justify-between gap-4">
      <h2 class="text-4xl sm:text-5xl lg:text-[4.5rem]">Featured retreats</h2>
      <a href="/retreats/" class="font-bold text-charcoal underline underline-offset-4 hover:text-cobalt">Browse all retreats →</a>
    </div>

    <div class="mt-9 grid gap-x-7 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
      {featuredRetreats.map((listing, i) => (
        <ListingCard
          index={i}
          slug={listing.id}
          name={listing.data.name}
          mode={listing.data.mode}
          categoryLabel={CATEGORY_META[listing.data.categories[0]]?.label ?? listing.data.categories[0]}
          country={listing.data.country}
          destinationSlug={listing.data.destinationSlug}
          region={listing.data.region}
          priceBandAUD={listing.data.priceBandAUD}
          durationDays={listing.data.durationDays}
          featuredTier={listing.data.featuredTier}
          claimed={listing.data.claimed}
        />
      ))}
    </div>
  </section>

  <!-- Category tiles -->
  <section class="mx-auto max-w-[1360px] px-4 pb-16 sm:px-6 md:pb-20 lg:px-10">
    <h2 class="text-4xl sm:text-5xl lg:text-[4.5rem]">Browse by category</h2>
    <div class="mt-9 grid sm:grid-cols-2 lg:grid-cols-3">
      {RETREAT_CATEGORIES.map((cat) => (
        <CategoryTile slug={cat.slug} href={`/retreats/${cat.slug}/`} label={cat.label} description={cat.description} />
      ))}
    </div>
    <div class="mt-7 grid border-2 border-charcoal sm:grid-cols-2">
      <a href="/clinics/ketamine/" class="block p-5 text-charcoal no-underline hover:bg-cream-dark sm:border-r-2 sm:border-charcoal">
        <h3 class="font-sans text-[1.2rem] font-bold text-charcoal">Ketamine Clinics (Australia)</h3>
        <p class="mt-1 text-[0.97rem] text-charcoal-soft">Australian clinical ketamine services — factual, neutral-mode listings.</p>
      </a>
      <a href="/clinics/psychedelic-assisted-therapy/" class="block border-t-2 border-charcoal p-5 text-charcoal no-underline hover:bg-cream-dark sm:border-t-0">
        <h3 class="font-sans text-[1.2rem] font-bold text-charcoal">Psychedelic-Assisted Therapy (Australia)</h3>
        <p class="mt-1 text-[0.97rem] text-charcoal-soft">Authorised prescriber pathway services — factual, neutral-mode listings.</p>
      </a>
    </div>
  </section>

  <!-- Latest news -->
  <section class="mx-auto max-w-[1360px] px-4 pb-16 sm:px-6 md:pb-20 lg:px-10">
    <div class="flex flex-wrap items-baseline justify-between gap-4">
      <h2 class="text-4xl sm:text-5xl lg:text-[4.5rem]">Latest news</h2>
      <a href="/news/" class="font-bold text-charcoal underline underline-offset-4 hover:text-cobalt">All news →</a>
    </div>
    <div class="mt-9 border-t-[3px] border-charcoal">
      {latestNews.map((item) => (
        <a href={`/news/${item.id}/`} class="news-row group grid gap-1.5 border-b-2 border-charcoal py-5 text-charcoal no-underline md:grid-cols-[150px_minmax(0,1fr)_40px] md:items-baseline md:gap-6 md:py-6">
          <time class="caps text-charcoal" datetime={item.data.publishedAt.toISOString()}>
            {item.data.publishedAt.toLocaleDateString('en-AU', { day: 'numeric', month: 'short', year: 'numeric' })}
          </time>
          <h3 class="font-serif text-[1.5rem] leading-[1.12] text-charcoal group-hover:text-cobalt md:text-[2.125rem]">{item.data.title}</h3>
          <span class="hidden text-right text-2xl md:block" aria-hidden="true">→</span>
        </a>
      ))}
    </div>
  </section>

  <!-- Lead magnet -->
  <section class="mx-auto max-w-[1360px] px-4 pb-4 sm:px-6 lg:px-10">
    <NewsletterSignup source="home" />
  </section>
</BaseLayout>

<style>
  .hero :global(.hero-pattern) {
    right: 0;
    top: 0;
    height: 100%;
    width: 46%;
  }
  .marks {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }
  .marks::before {
    content: '';
    width: 0.7rem;
    height: 0.7rem;
    background: var(--color-marigold);
  }
  @media (max-width: 900px) {
    .hero :global(.hero-pattern) {
      width: 100%;
      opacity: 0.28;
    }
  }
</style>
